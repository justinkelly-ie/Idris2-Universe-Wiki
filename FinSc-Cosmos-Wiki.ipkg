package FinSc-Cosmos-Wiki
version = 0.3.0
opts = "--codegen chez"

depends = FinSc-Biology, FinSc-Chemistry, FinSc-Cosmology, FinSc-Electromagnetism, FinSc-Fields, FinSc-Geometry, FinSc-Hadron, FinSc-Multiset-Binary, FinSc-Multiset-Core, FinSc-Multiset-Ternary, FinSc-Multiset-Transform, FinSc-Physics, FinSc-QuantumComputing, FinSc-Thermodynamics, FinSc-Topology, FinSc-Cosmos, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.EmpiricalMeasurementSpec,
          Wiki.Foundations.Discrete_Box_Algebra_and_Contour_Geometry,
          Wiki.Foundations.Multiset_Transform_2_Categories_and_Tensor_Operators,
          Wiki.Foundations.Scale_Pipelines_Galois_Connections_and_Free_Energy,
          Wiki.Geometry.Elliptic_Bound_State_Confinement,
          Wiki.Geometry.Hyperbolic_Gauge_Flux_and_Mixing,
          Wiki.Geometry.Parabolic_Dissipation_and_Recombination,
          Wiki.Geometry.Substrate_Free_Energy_and_Causal_Arrow,
          Wiki.Index,
          Wiki.InvertedOpenScaleTransformSpec,
          Wiki.Main,
          Wiki.ScalePipelineStreamSpec,
          Wiki.Verification.Cosmological_Inferences_and_Deductions,
          Wiki.Verification.EmpiricalObservationSuite,
          Wiki.Verification.FoundationsSuite,
          Wiki.Verification.Index,
          Wiki.Verification.PhysicalLawsSuite,
          Wiki.Verification.Physical_Laws_Bibliography_and_Sources,
          Wiki.Verification.ScalePipelineSuite,
          Wiki.Verification.Structural_Associativity_Proof,
          Wiki.Verification.TestHarness,
          Wiki.Verification.Verification_Matrix,
          Wiki.Verification.Witnesses.MotivicGalois,
          Wiki.Verification.Witnesses.UnifiedWitnesses

main = Wiki.Main
executable = cosmos-verify
