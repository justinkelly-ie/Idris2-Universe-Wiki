package Idris2-Universe-Wiki
version = 0.3.0
executable = universe-verify
main = Main
opts = "--codegen chez"

depends = base,
          Idris2-Multiset-Core,
          Idris2-Multiset-Transform,
          Idris2-Multiset-Binary,
          Idris2-Multiset-Ternary,
          Idris2-Geometry,
          Idris2-Physics,
          Idris2-Hadron,
          Idris2-Chemistry,
          Idris2-Biology,
          Idris2-Universe

sourcedir = "Library/Wiki"

modules = Verification.Witnesses.UnifiedWitnesses,
          Main,
          Foundations.Discrete_Box_Algebra_and_Contour_Geometry,
          Foundations.Multiset_Transform_2_Categories_and_Tensor_Operators,
          Foundations.Scale_Pipelines_Galois_Connections_and_Free_Energy,
          Geometry.Elliptic_Bound_State_Confinement,
          Geometry.Hyperbolic_Gauge_Flux_and_Mixing,
          Geometry.Parabolic_Dissipation_and_Recombination,
          Geometry.Substrate_Free_Energy_and_Causal_Arrow,
          InvertedOpenScaleTransformSpec,
          Verification.Verification_Matrix
